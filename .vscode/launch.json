{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Express",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "nodemon",
                "--exec",
                "node --import tsx",
                "${workspaceFolder}/examples/express.ts"
            ],
            "cwd": "${workspaceFolder}",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal",
            "restart": true,
            "autoAttachChildProcesses": true
        }
    ]
}